<!doctype html>
<html lang="en">
<head>
<title>Morning Digest · {{ date_short }}</title>
{% include "_head.html.j2" %}
</head>
<body>
<div class="wrap">
  <header class="masthead">
    <div class="eyebrow">{{ greeting }}</div>
    <h1>The Morning <em>Digest</em></h1>
    <div class="dateline">
      <span>{{ date_human }}</span>
      <span>Five pieces, picked from {{ n_candidates }}</span>
      <span>{% if total_minutes %}~{{ total_minutes }} min read{% else %}{{ picks|length }} pieces{% endif %}</span>
    </div>
    <nav class="shelf" aria-label="Your library">
      <a href="library.html#later">Read later <b data-count="later">0</b></a>
      <a href="library.html#saved">Saved <b data-count="saved">0</b></a>
      <a href="archive.html">Archive</a>
    </nav>
  </header>

{% if not picks %}
  <p class="empty">Nothing new worth your time today. Enjoy the quiet.</p>
{% else %}
  {% set core = picks|rejectattr("wildcard")|list %}
  {% set wild = picks|selectattr("wildcard")|list %}
  <ol class="picks">
  {% for p in core %}
    {% set i = loop.index0 %}
    <li class="pick" data-idx="{{ i }}">
      <div class="num">{{ "%02d"|format(loop.index) }}</div>
      {% include "_pick.html.j2" %}
    </li>
  {% endfor %}
  </ol>

  {% for p in wild %}
    {% set i = core|length %}
    <div class="wild-head">Wildcard</div>
    <div class="pick wild" data-idx="{{ i }}">
      <div class="num">✦</div>
      <div>
        <p class="wild-note">Outside your usual interests: the best piece today that you probably wouldn't have gone looking for.</p>
        {% include "_pick.html.j2" %}
      </div>
    </div>
  {% endfor %}
{% endif %}

  <footer class="end">
    <div class="fleuron">❦</div>
    <p>That's everything for today. See you tomorrow.</p>
    <div class="colophon">
      {{ method }} · {{ n_candidates }} candidates from the last {{ window_hours }} hours<br>
      <a href="library.html">Your library</a> &nbsp;·&nbsp;
      <a href="archive.html">Archive</a>{% if repo %} &nbsp;·&nbsp;
      <a href="#" id="token-link">Set up one-tap sending</a> &nbsp;·&nbsp;
      <a href="https://github.com/{{ repo }}/blob/main/taste.md">Taste profile</a> &nbsp;·&nbsp;
      <a href="https://github.com/{{ repo }}/blob/main/state/learned_taste.md">What it's learned</a> &nbsp;·&nbsp;
      <a href="https://github.com/{{ repo }}/blob/main/feeds.yaml">Sources</a>{% endif %}
    </div>
  </footer>
</div>

<div class="sendbar" id="sendbar" role="region" aria-label="Send feedback">
  <span id="send-msg"></span>
  <button id="send" type="button">{% if repo %}Send to GitHub{% else %}Copy JSON{% endif %}</button>
</div>

<script>
(() => {
{% include "_shared.js.j2" %}

  const PICKS = {{ picks_js|tojson }};
  const KEY = "digest-feedback-" + DATE;
  let state = load(KEY);
  getVotes = () => Object.entries(state).filter(([, s]) => s.vote).map(([i, s]) => ({
    url: PICKS[i].url, title: PICKS[i].title, source: PICKS[i].source, wildcard: PICKS[i].wildcard,
    vote: s.vote, tags: s.tags || [], note: (s.note || "").trim(),
  }));

  function paint(card) {
    const s = state[card.dataset.idx] || {};
    card.querySelectorAll(".vote").forEach(b => {
      const on = b.dataset.vote === s.vote;
      b.classList.toggle("on", on);
      b.setAttribute("aria-pressed", on);
    });
    card.querySelectorAll(".tags").forEach(row => {
      const show = row.dataset.for === s.vote;
      row.classList.toggle("show", show);
      row.querySelectorAll(".chip").forEach(c => {
        const on = show && (s.tags || []).includes(c.dataset.tag);
        c.classList.toggle("on", on); c.setAttribute("aria-pressed", on);
      });
      const note = row.querySelector(".note");
      if (document.activeElement !== note) note.value = show ? (s.note || "") : "";
    });
    const label = card.querySelector(".fb-label");
    label.textContent = s.vote === "up" ? "What worked?" : s.vote === "down" ? "What missed?" : "";
    card.classList.toggle("read", !!s.vote);  // rated = read

    const list = libList(PICKS[card.dataset.idx].url);
    card.querySelectorAll(".lib").forEach(b => {
      const on = b.dataset.list === list;
      b.classList.toggle("on", on);
      b.setAttribute("aria-pressed", on);
      b.querySelector(".txt").textContent = on ? b.dataset.on : b.dataset.off;
    });
  }

  document.querySelectorAll(".pick").forEach(card => {
    const idx = card.dataset.idx;
    card.querySelectorAll(".vote").forEach(b => b.addEventListener("click", () => {
      const cur = state[idx] || {};
      state[idx] = cur.vote === b.dataset.vote ? {} : { vote: b.dataset.vote, tags: [], note: "" };
      store(KEY, state); paint(card); refreshBar();
    }));
    card.querySelectorAll(".chip").forEach(c => c.addEventListener("click", () => {
      const s = state[idx]; if (!s || !s.vote) return;
      s.tags = s.tags.includes(c.dataset.tag) ? s.tags.filter(t => t !== c.dataset.tag) : [...s.tags, c.dataset.tag];
      store(KEY, state); paint(card); refreshBar();
    }));
    card.querySelectorAll(".note").forEach(inp => inp.addEventListener("input", () => {
      const s = state[idx]; if (!s || !s.vote) return;
      s.note = inp.value; store(KEY, state); refreshBar();
    }));
    card.querySelectorAll(".lib").forEach(b => b.addEventListener("click", () => {
      const { wildcard, ...item } = PICKS[idx];
      toggleLib(item, b.dataset.list);
      paint(card); paintShelfCounts(); refreshBar();
    }));
    paint(card);
  });
  paintShelfCounts();
  refreshBar();

  document.getElementById("send").addEventListener("click", () => sendFeedback());
})();
</script>
</body>
</html>
