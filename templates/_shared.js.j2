  // ── Shared by the digest and library pages ──────────────────────────────
  const DATE = {{ date_iso|tojson }};
  const REPO = {{ repo|tojson }};
  const PREFIX = {{ issue_prefix|tojson }};
  const SERVER_LIB = {{ library_js|tojson }};   // {url: "later" | "saved"} as of the last build
  const CAT_LABELS = {{ category_labels|tojson }};
  const load = k => { try { return JSON.parse(localStorage.getItem(k) || "{}"); } catch (e) { return {}; } };
  const store = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };

  // Library changes made in this browser that the site hasn't picked up yet: {url: {list, item}}.
  // list null = remove. Entries disappear once a build reflects them.
  const LIB_KEY = "digest-library-pending";
  let pending = load(LIB_KEY);
  for (const [u, p] of Object.entries(pending)) if ((SERVER_LIB[u] || null) === (p.list || null)) delete pending[u];
  store(LIB_KEY, pending);

  const libList = url => (url in pending ? pending[url].list : (SERVER_LIB[url] || null));
  function setLibList(item, list) {
    if ((SERVER_LIB[item.url] || null) === list) delete pending[item.url];
    else pending[item.url] = { list, item };
    store(LIB_KEY, pending);
  }
  const toggleLib = (item, list) => setLibList(item, libList(item.url) === list ? null : list);

  function mergedLibrary() {
    const all = { ...SERVER_LIB };
    for (const [u, p] of Object.entries(pending)) { if (p.list) all[u] = p.list; else delete all[u]; }
    return all;
  }
  function paintShelfCounts() {
    const c = { later: 0, saved: 0 };
    Object.values(mergedLibrary()).forEach(l => c[l]++);
    document.querySelectorAll("[data-count]").forEach(el => { el.textContent = c[el.dataset.count]; });
  }

  // ── Send bar: one GitHub issue carries ratings and library changes ──────
  // With a GitHub token saved in this browser, Send files the issue directly (one tap).
  // Without one, or if the token fails, it opens GitHub's pre-filled issue form instead.
  const bar = document.getElementById("sendbar");
  const msg = document.getElementById("send-msg");
  const sendBtn = document.getElementById("send");
  const TOKEN_KEY = "digest-gh-token", SENT_KEY = "digest-sent";
  const token = () => load(TOKEN_KEY).t || "";
  let getVotes = () => [];     // the digest page replaces this with its ratings
  let useForm = false;         // set after a failed one-tap send: the next tap opens the form
  const buildPayload = () => JSON.stringify({
    date: DATE, votes: getVotes(), library: Object.values(pending).map(p => ({ ...p.item, list: p.list })),
  }, null, 1);

  function refreshBar() {
    if (!bar) return;
    const nVotes = getVotes().length, nLib = Object.keys(pending).length;
    const sent = nVotes + nLib > 0 && load(SENT_KEY).payload === buildPayload();
    bar.classList.toggle("show", nVotes + nLib > 0);
    const parts = [];
    if (nVotes) parts.push(`${nVotes} rating${nVotes === 1 ? "" : "s"}`);
    if (nLib) parts.push(`${nLib} library change${nLib === 1 ? "" : "s"}`);
    msg.textContent = sent ? "Sent ✓ Applies at the next build" : parts.join(" · ");
    sendBtn.hidden = sent;
    sendBtn.textContent = !REPO ? "Copy JSON" : token() && !useForm ? "Send" : "Send to GitHub";
  }

  async function sendFeedback() {
    const payload = buildPayload();
    if (!REPO) {
      try { await navigator.clipboard.writeText(payload); msg.textContent = "Copied to clipboard"; }
      catch (e) { console.log(payload); msg.textContent = "Logged to console"; }
      return;
    }
    const title = `${PREFIX} ${DATE}`;
    const body = "Feedback from the morning digest. Submit as-is: the next run reads it, logs it, and closes this issue.\n\n```json\n" + payload + "\n```\n";
    if (token() && !useForm) {
      msg.textContent = "Sending…"; sendBtn.disabled = true;
      let problem;
      try {
        const r = await fetch(`https://api.github.com/repos/${REPO}/issues`, {
          method: "POST",
          headers: { Authorization: `Bearer ${token()}`, Accept: "application/vnd.github+json", "Content-Type": "application/json" },
          body: JSON.stringify({ title, body }),
        });
        if (r.ok) { store(SENT_KEY, { payload }); sendBtn.disabled = false; refreshBar(); return; }
        problem = [401, 403, 404].includes(r.status) ? "GitHub rejected the saved token." : `GitHub answered ${r.status}.`;
      } catch (e) { problem = "Couldn't reach GitHub."; }
      sendBtn.disabled = false; useForm = true; refreshBar();
      msg.textContent = problem + " Tap again to use the form";
      return;
    }
    window.open(`https://github.com/${REPO}/issues/new?` + new URLSearchParams({ title, body, labels: "digest-feedback" }), "_blank", "noopener");
    msg.textContent = "Opened. Click “Create” on GitHub";
  }

  const tokenLink = document.getElementById("token-link");
  if (tokenLink) {
    const paintToken = () => { tokenLink.textContent = token() ? "One-tap sending: on" : "Set up one-tap sending"; };
    tokenLink.addEventListener("click", e => {
      e.preventDefault();
      const v = prompt(
        `Paste a GitHub fine-grained token that can only do one thing: read and write Issues on ${REPO}.\n\n` +
        "It is kept in this browser only and sent only to api.github.com. Leave it blank to turn one-tap sending off.", "");
      if (v === null) return;
      store(TOKEN_KEY, v.trim() ? { t: v.trim() } : {});
      useForm = false; paintToken(); refreshBar();
    });
    paintToken();
  }
